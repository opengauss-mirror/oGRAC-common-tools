db=postgres
driver=org.opengauss.Driver
conn=jdbc:opengauss://<host>:<port>/<database>?loggerLevel=OFF
user=<user>
password=<password>

warehouses=1000
loadWorkers=80

terminals=696
runTxnsPerTerminal=0
runMins=0
limitTxnsPerMin=0
terminalWarehouseFixed=true
newOrderWeight=45
paymentWeight=43
orderStatusWeight=4
deliveryWeight=4
stockLevelWeight=4
